{
  "schemaVersion": 1,
  "id": "autotrading",
  "version": "${version}",
  "name": "Auto Trading",
  "description": "Client-side villager trading route: take items, trade, and put the result away.",
  "authors": ["Nergan"],
  "license": "MPL-2.0",
  "icon": "assets/autotrading/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.autotrading.mod.client.AutoTradingClient"],
    "modmenu": ["com.autotrading.mod.client.AutoTradingModMenu"]
  },
  "mixins": ["autotrading.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.14.2+kotlin.2.4.21",
    "cloth-config": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
